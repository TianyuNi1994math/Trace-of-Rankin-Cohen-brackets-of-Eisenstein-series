from sage.all import ZZ, QQ, matrix, kronecker


def fourier_coefficient_matrix(primes, parameters, print_output=True):
    r"""
    Form and analyze the matrix of the first d Fourier coefficients.

    INPUT:

        primes       -- tuple/list (p_1, ..., p_d) of odd primes
        parameters   -- tuple/list (k_1, k_2, c)
        print_output -- if True, print the matrix, determinant,
                        and singularity status

    MATRIX CONVENTION:

        If d = len(primes), then

            M[i-1, n-1]
              = a_{p_i,k_1,k_2,c}(n; chi_{p_i})

        for 1 <= i,n <= d.

        Therefore:
            row i    corresponds to p_i;
            column n corresponds to the Fourier index n.

    OUTPUT:

        (M, det_M, status), where

            M       -- the d by d matrix over QQ
            det_M   -- its exact determinant
            status  -- "singular" or "non-singular"

    EXAMPLE:

        M, det_M, status = fourier_coefficient_matrix(
            (7, 11), (3, 15, 3)
        )
    """

    # Convert the first input to a list of Sage integers.
    try:
        p_list = [ZZ(p) for p in primes]
    except (TypeError, ValueError) as exc:
        raise TypeError(
            "The first input must be an iterable of integers "
            "(p_1,...,p_d)."
        ) from exc

    # Convert the second input to a list and check its length.
    try:
        parameter_list = list(parameters)
    except TypeError as exc:
        raise TypeError(
            "The second input must be an iterable (k_1,k_2,c)."
        ) from exc

    if len(parameter_list) != 3:
        raise ValueError(
            "The second input must contain exactly (k_1,k_2,c)."
        )

    try:
        k1, k2, c = map(ZZ, parameter_list)
    except (TypeError, ValueError) as exc:
        raise TypeError(
            "k_1, k_2, and c must be integers."
        ) from exc

    d = len(p_list)

    if d == 0:
        raise ValueError("At least one prime p_i is required.")

    # Check the common weight and Rankin-Cohen parameters.
    if k1 < 3 or k2 < k1:
        raise ValueError("Require 3 <= k_1 <= k_2.")

    if (k1 - k2) % 2 != 0:
        raise ValueError(
            "k_1 and k_2 must have the same parity."
        )

    if c < 0:
        raise ValueError("c must be nonnegative.")

    # Check that every p_i is an odd prime.
    nonprimes = [
        p for p in p_list
        if p <= 2 or not p.is_prime()
    ]

    if nonprimes:
        raise ValueError(
            "Every p_i must be an odd prime; "
            "invalid entries: {}".format(nonprimes)
        )

    # Check chi_{p_i}(-1) = (-1)^k_1.
    #
    # For an odd prime p:
    #     chi_p(-1) = 1  iff p == 1 mod 4,
    #     chi_p(-1) = -1 iff p == 3 mod 4.
    expected_parity = ZZ(-1) ** k1

    parity_failures = [
        p for p in p_list
        if ZZ(kronecker(-1, p)) != expected_parity
    ]

    if parity_failures:
        raise ValueError(
            "The condition chi_p(-1)=(-1)^k_1 fails for: {}. "
            "For even k_1 use primes p_i == 1 (mod 4); "
            "for odd k_1 use primes p_i == 3 (mod 4)."
            .format(parity_failures)
        )

    # Construct the matrix:
    #
    #     M[i-1,n-1]
    #       = a_{p_i,k_1,k_2,c}(n; chi_{p_i}).
    #
    # The function a_p_k1_k2_c is the function defined in
    # the previous SageMath code.
    M = matrix(
        QQ,
        [
            [
                a_p_k1_k2_c(p, k1, k2, c, n)
                for n in range(1, d + 1)
            ]
            for p in p_list
        ],
    )

    # Exact determinant over QQ.
    det_M = M.determinant()

    # Exact singularity test.
    status = (
        "singular"
        if det_M == 0
        else "non-singular"
    )

    if print_output:
        print("Fourier-coefficient matrix M")
        print("  rows:    p_i = {}".format(tuple(p_list)))
        print("  columns: n = 1, ..., {}".format(d))
        print(
            "  M[i-1,n-1] = "
            "a_{p_i,k_1,k_2,c}(n; chi_{p_i})"
        )
        print(M)

        print("\ndeterminant(M) =")
        print(det_M)

        print("\nstatus =")
        print(status)

        if len(set(p_list)) < d:
            print(
                "\nNote: repeated primes produce repeated rows, "
                "so the matrix is necessarily singular."
            )

    return M, det_M, status


# Optional shorter descriptive name.
analyze_fourier_matrix = fourier_coefficient_matrix
